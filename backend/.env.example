# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local MongoDB)
# Replace with your actual credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/loan_saathi?retryWrites=true&w=majority
# Or for local development:
# MONGODB_URI=mongodb://localhost:27017/loan_saathi

# JWT Authentication (Phase 2)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini API (Phase 3: AI Extraction & RAG)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face Semantic Ranking Microservice (FastAPI on Port 8000)
ML_SERVICE_URL=http://localhost:8000
